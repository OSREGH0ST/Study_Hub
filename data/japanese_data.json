    "verbs": {
      "sub_tabs": [
        {
          "id": "verb-uses",
          "label": "Uses & Cases",
          "sections": [
            {
              "type": "card",
              "title": "When to use which form?",
              "color": "cyan",
              "info_boxes": [
                { "variant": "blue", "label": "~ます (Masu Form)", "body": "<b>Use case:</b> Polite, everyday conversation. You use this with teachers, strangers, and coworkers.", "example": "たべます (I eat / I will eat)" },
                { "variant": "green", "label": "Dictionary Form", "body": "<b>Use case:</b> Casual conversation (with friends), finding words in the dictionary, and as a base for advanced grammar.", "example": "たべる (I eat / I will eat)" },
                { "variant": "gold", "label": "~て (Te Form)", "body": "<b>Use case:</b> The \"glue\" form. Used to connect actions, ask for favors (~てください), or express ongoing actions (~ています).", "example": "たべて (Eat and...)" },
                { "variant": "red", "label": "~ない (Nai Form)", "body": "<b>Use case:</b> The casual negative. Used with friends to say you won't do something.", "example": "たべない (I don't eat)" }
              ]
            }
          ]
        },
        {
          "id": "verb-masu",
          "label": "~masu Form",
          "sections": [
            {
              "type": "card",
              "title": "Verb Tense Reference (Formal ~masu)",
              "color": "gold",
              "tense_grid": [
                { "label": "Present (+)", "jp": "~ます", "example": "たべます (Eat)", "variant": "green" },
                { "label": "Present (-)", "jp": "~ません", "example": "たべません (Don't eat)", "variant": "red" },
                { "label": "Past (+)", "jp": "~ました", "example": "たべました (Ate)", "variant": "blue" },
                { "label": "Past (-)", "jp": "~ませんでした", "example": "たべませんでした", "variant": "orange" }
              ]
            },
            {
              "type": "card",
              "title": "Invitations & Proposals",
              "color": "pink",
              "info_boxes": [
                { "variant": "purple", "label": "Let's...", "jp": "~ましょう", "example": "いきましょう (Let's go)" },
                { "variant": "cyan", "label": "Won't you...?", "jp": "~ませんか", "example": "のみませんか (Won't you drink?)" },
                { "variant": "gold", "label": "Shall I/we...?", "jp": "~ましょうか", "example": "てつだいましょうか (Shall I help?)" }
              ]
            }
          ]
        },
        {
          "id": "verb-te",
          "label": "~te Form",
          "sections": [
            {
              "type": "card",
              "title": "Making the ~て (Te) Form from ~ます",
              "color": "pink",
              "te_rules": [
                { "header": "Group 1: U-Verbs (The Rule-Breakers)", "headerColor": "#60a5fa", "rules": [
                  { "condition": "Before ~ます is い, ち, り (i, chi, ri)", "result": "→ って (tte)", "example": "かいます → かって" },
                  { "condition": "Before ~ます is み, び, に (mi, bi, ni)", "result": "→ んで (nde)", "example": "のみます → のんで" },
                  { "condition": "Before ~ます is き (ki)", "result": "→ いて (ite)", "example": "かきます → かいて" },
                  { "condition": "Before ~ます is ぎ (gi)", "result": "→ いで (ide)", "example": "およぎます → およいで" },
                  { "condition": "Before ~ます is し (shi)", "result": "→ して (shite)", "example": "はなします → はなして" }
                ], "note": { "variant": "red", "text": "⚠️ Exception: いきます (To go) becomes いって (not いいて)." } },
                { "header": "Group 2: Ru-Verbs (The Easy Ones)", "headerColor": "#10b981", "rules": [
                  { "condition": "Just drop ~ます and add て", "result": "たべます → たべて (tabete)" },
                  { "condition": "Just drop ~ます and add て", "result": "みます → みて (mite)" }
                ] },
                { "header": "Group 3: Irregular Verbs", "headerColor": "#fb923c", "rules": [
                  { "condition": "To do (します)", "result": "→ して (shite)" },
                  { "condition": "To come (きます)", "result": "→ きて (kite)" }
                ] }
              ]
            },
            {
              "type": "card",
              "title": "The ~て Power-Ups",
              "color": "gold",
              "info_boxes": [
                { "variant": "blue", "label": "~ている (Ongoing Action / State)", "body": "1. Currently doing it. 2. A state resulting from a past action.", "jp": "たべて います", "example": "(I am eating right now)" },
                { "variant": "green", "label": "~てある (Intentional State)", "body": "Shows a state that exists because someone intentionally did it in the past.", "jp": "かいて あります", "example": "(It has been written [by someone])" },
                { "variant": "pink", "label": "~てください (Please do...)", "body": "The polite way to ask someone to do something.", "jp": "まって ください", "example": "(Please wait)" },
                { "variant": "orange", "label": "~てから (After doing...)", "body": "Action A happens, and then Action B happens.", "jp": "たべて から、ねます", "example": "(After I eat, I will sleep)" },
                { "variant": "cyan", "label": "~てもいいです (Permission)", "body": "Used to grant permission or ask \"Is it okay if I...?\"", "jp": "みても いいですか？", "example": "(May I look?)" },
                { "variant": "red", "label": "~てはいけません (Prohibition)", "body": "A strong rule or prohibition. \"You must not do this.\"", "jp": "のんで は いけません", "example": "(You must not drink)" },
                { "variant": "purple", "label": "~てしまう (Oops / Finished)", "body": "Shows you finished something completely OR did something by accident and regret it.", "jp": "わすれて しまいました", "example": "(I completely forgot / I accidentally forgot)", "fullWidth": true }
              ]
            }
          ]
        },
        {
          "id": "verb-dict",
          "label": "Dictionary Form",
          "sections": [
            {
              "type": "card",
              "title": "Dictionary Form (Casual Present)",
              "color": "purple",
              "info_boxes": [
                { "variant": "blue", "label": "Group 1: From ~ます to Dictionary", "body": "Change the 'i' sound before ~ます to an 'u' sound.", "examples": [{"ex":"のみます → のむ (nomu)"},{"ex":"かきます → かく (kaku)"}] },
                { "variant": "green", "label": "Group 2: From ~ます to Dictionary", "body": "Drop ~ます and add る (ru).", "examples": [{"ex":"たべます → たべる (taberu)"},{"ex":"みます → みる (miru)"}] }
              ],
              "table": { "header": "Irregular Forms", "items": [{"en":"します (To do)","jp":"→ する (suru)"},{"en":"きます (To come)","jp":"→ くる (kuru)"}] }
            },
            {
              "type": "card",
              "title": "Nai Form (Casual Negative) — N4",
              "color": "red",
              "info_boxes": [
                { "variant": "red", "label": "Group 1: U-Verbs", "body": "Change the 'u' ending to 'a' + ない.", "examples": [{"ex":"のむ → のまない"},{"ex":"かく → かかない"},{"ex":"はなす → はなさない"}] },
                { "variant": "blue", "label": "Group 2: Ru-Verbs", "body": "Drop る and add ない.", "examples": [{"ex":"たべる → たべない"},{"ex":"みる → みない"}] },
                { "variant": "orange", "label": "Irregulars", "body": "", "examples": [{"ex":"する → しない"},{"ex":"くる → こない"}] }
              ]
            }
          ]
        },
